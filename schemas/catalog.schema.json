{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/catalog.schema.json",
  "title": "Language Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["tag", "englishName", "nativeName", "script", "direction", "availableForDownload", "status"],
    "properties": {
      "tag": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{2,4}){0,3}$" },
      "englishName": { "type": "string" },
      "nativeName": { "type": "string" },
      "script": { "type": "string" },
      "direction": { "type": "string", "enum": ["ltr", "rtl"] },
      "family": { "type": "string" },
      "implemented": { "type": "boolean" },
      "validated": { "type": "boolean" },
      "availableForDownload": { "type": "boolean" },
      "status": { "type": "string", "enum": ["available", "catalog-only"] },
      "packVersion": { "type": ["string", "null"] },
      "minAppVersion": { "type": ["integer", "null"] },
      "layoutType": { "type": ["string", "null"] },
      "inputMethod": { "type": ["string", "null"] },
      "sizeBytes": { "type": ["integer", "null"] },
      "sha256": { "type": ["string", "null"] },
      "path": { "type": ["string", "null"] }
    }
  }
}
