{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/manifest.schema.json",
  "title": "Language Pack Manifest",
  "type": "object",
  "required": ["schemaVersion", "tag", "name", "script", "direction", "packVersion", "minAppVersion", "files", "sha256"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "packFormat": { "type": "integer" },
    "tag": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{2,4}){0,3}$" },
    "name": {
      "type": "object",
      "required": ["english", "native"],
      "properties": {
        "english": { "type": "string" },
        "native": { "type": "string" }
      }
    },
    "script": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" },
    "direction": { "type": "string", "enum": ["ltr", "rtl"] },
    "cased": { "type": "boolean" },
    "layoutType": { "type": "string" },
    "inputMethod": { "type": "string" },
    "packVersion": { "type": "string" },
    "minAppVersion": { "type": "integer" },
    "bytes": { "type": "integer" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer" }
        }
      }
    },
    "features": { "type": "object" }
  }
}
