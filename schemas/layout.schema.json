{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/layout.schema.json",
  "title": "Keyboard Layout",
  "type": "object",
  "required": ["schemaVersion", "tag", "layers"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "tag": { "type": "string" },
    "script": { "type": "string" },
    "direction": { "type": "string", "enum": ["ltr", "rtl"] },
    "cased": { "type": "boolean" },
    "layoutType": { "type": "string" },
    "inputMethod": { "type": "string" },
    "note": { "type": "string" },
    "layers": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": { "$ref": "#/definitions/rows" }
    }
  },
  "definitions": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/definitions/key" }
      }
    },
    "key": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "o": { "type": "string" },
            "l": { "type": "string" },
            "hold": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "code": { "type": "string", "enum": ["SHIFT", "DELETE", "ENTER", "SPACE", "SYMBOLS", "SYMBOLS2", "ABC", "EMOJI", "LANG", "MODE"] },
            "w": { "type": "number", "minimum": 0.1 }
          },
          "anyOf": [ { "required": ["o"] }, { "required": ["code"] } ]
        }
      ]
    }
  }
}
